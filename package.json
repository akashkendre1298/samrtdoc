{
  "name": "smartdoc",
  "displayName": "SmartDoc",
  "description": "Automatically generate comprehensive documentation for your project with a single command.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:smartdoc.generateAll",
    "onCommand:smartdoc.readme"
  ],
  "main": "./smartdoc/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartdoc.generateAll",
        "title": "SmartDoc: Generate Docs"
      },
      {
        "command": "smartdoc.readme",
        "title": "SmartDoc: Generate README.md"
      }
    ]
  },
  "scripts": {
    "lint": "eslint ./smartdoc/src",
    "pretest": "npm run lint",
    "test": "vscode-test run --extensionDevelopmentPath=."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1"
  },
  "dependencies": {
    "ejs": "^3.1.10"
  }
}
